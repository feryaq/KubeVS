{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KubeVS recipe pack",
  "type": "object",
  "required": ["format", "version", "id", "name", "schemas"],
  "properties": {
    "format": {
      "const": "kubevs-recipe-pack"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "./recipe-template.schema.json"
      }
    }
  },
  "additionalProperties": false
}
