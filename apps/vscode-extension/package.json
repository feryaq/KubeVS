{
  "name": "kubevs-extension",
  "displayName": "KubeVS",
  "description": "%extension.description%",
  "version": "1.7.0",
  "private": true,
  "publisher": "kubevs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Feryaq/KubeVS.git"
  },
  "homepage": "https://github.com/Feryaq/KubeVS#readme",
  "bugs": {
    "url": "https://github.com/Feryaq/KubeVS/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "kubejs",
    "minecraft",
    "neoforge",
    "recipes"
  ],
  "activationEvents": [
    "onFileSystem:kubevs-remote",
    "onStartupFinished",
    "onCommand:kubevs.openDashboard",
    "onView:kubevs.home"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "vscode:prepublish": "pnpm build:release",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "build:release": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs --minify --legal-comments=none",
    "build:test-addon": "esbuild src/addonRecipeCore.ts --bundle --platform=node --format=esm --outfile=dist/addonRecipeCore.mjs",
    "build:test-webview": "esbuild src/addonRecipeEditor.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/addonRecipeEditor.cjs",
    "build:test-loot": "esbuild src/lootRuleCore.ts --bundle --platform=node --format=esm --outfile=dist/lootRuleCore.mjs",
    "build:test-auth": "esbuild src/connectorAuthCore.ts --bundle --platform=node --format=esm --outfile=dist/connectorAuthCore.mjs",
    "build:test-client": "esbuild src/connectorClient.ts --bundle --platform=node --format=cjs --outfile=dist/connectorClient.cjs",
    "build:test-removal": "esbuild src/recipeRemovalCore.ts --bundle --platform=node --format=esm --outfile=dist/recipeRemovalCore.mjs",
    "build:test-graph": "esbuild src/craftGraphCore.ts --bundle --platform=node --format=esm --outfile=dist/craftGraphCore.mjs",
    "build:test-graph-webview": "esbuild src/craftGraph.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/craftGraph.cjs",
    "build:test-target": "esbuild src/generatedTargetCore.ts --bundle --platform=node --format=esm --outfile=dist/generatedTargetCore.mjs",
    "build:test-content": "esbuild src/contentBuilderCore.ts --bundle --platform=node --format=esm --outfile=dist/contentBuilderCore.mjs",
    "build:test-replacement": "esbuild src/recipeReplacementCore.ts --bundle --platform=node --format=esm --outfile=dist/recipeReplacementCore.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && pnpm build:test-addon && pnpm build:test-webview && pnpm build:test-loot && pnpm build:test-auth && pnpm build:test-client && pnpm build:test-removal && pnpm build:test-graph && pnpm build:test-graph-webview && pnpm build:test-target && pnpm build:test-content && pnpm build:test-replacement && node --test test/addonRecipeCore.test.mjs test/addonRecipeWebview.test.mjs test/lootRuleCore.test.mjs test/connectorAuthCore.test.mjs test/connectorClient.test.mjs test/recipeRemovalCore.test.mjs test/craftGraphCore.test.mjs test/craftGraphWebview.test.mjs test/generatedTargetCore.test.mjs test/contentBuilderCore.test.mjs test/recipeReplacementCore.test.mjs test/recipeImport.test.mjs test/gregtechRecipeCore.test.mjs && pnpm build:test-mcp && node --test test/mcpServer.test.mjs && node ./test/run.mjs",
    "test:live-vscode": "pnpm build && node ./test/run-live-vscode.mjs",
    "test:unit": "pnpm build:test-addon && pnpm build:test-webview && pnpm build:test-loot && pnpm build:test-auth && pnpm build:test-client && pnpm build:test-removal && pnpm build:test-graph && pnpm build:test-graph-webview && pnpm build:test-target && pnpm build:test-content && pnpm build:test-replacement && pnpm build:test-mcp && node --test test/*.test.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:render": "node test/workbenchRender.mjs ../../artifacts/home-1.7.0",
    "test:visual": "node test/workbenchVisual.mjs ../../artifacts/home-1.7.0 ../../artifacts/home-1.7.0/screenshots --strict",
    "build:test-mcp": "esbuild src/mcpServer.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcpServer.mjs"
  },
  "dependencies": {
    "@kubevs/kubejs-parser": "workspace:*",
    "@kubevs/protocol": "workspace:*",
    "@kubevs/recipe-model": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.8",
    "mocha": "^11.7.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "kubevs.openDashboard",
        "title": "%command.openDashboard%",
        "category": "KubeVS",
        "icon": "$(dashboard)"
      },
      {
        "command": "kubevs.connect",
        "title": "%command.connect%",
        "category": "KubeVS",
        "icon": "$(plug)"
      },
      {
        "command": "kubevs.connectWithCode",
        "title": "%command.connectWithCode%",
        "category": "KubeVS",
        "icon": "$(key)"
      },
      {
        "command": "kubevs.disconnect",
        "title": "%command.disconnect%",
        "category": "KubeVS",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "kubevs.changeConnectorToken",
        "title": "%command.changeConnectorToken%",
        "category": "KubeVS",
        "icon": "$(key)"
      },
      {
        "command": "kubevs.openServerWorkspace",
        "title": "%command.openServerWorkspace%",
        "category": "KubeVS",
        "icon": "$(remote)"
      },
      {
        "command": "kubevs.showServerFileLocks",
        "title": "%command.showServerFileLocks%",
        "category": "KubeVS",
        "icon": "$(lock)"
      },
      {
        "command": "kubevs.validateProject",
        "title": "%command.validateProject%",
        "category": "KubeVS",
        "icon": "$(check-all)"
      },
      {
        "command": "kubevs.refreshProject",
        "title": "%command.refreshProject%",
        "category": "KubeVS",
        "icon": "$(refresh)"
      },
      {
        "command": "kubevs.saveAndReload",
        "title": "%command.saveAndReload%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.createRecipe",
        "title": "%command.createRecipe%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.createAddonRecipe",
        "title": "%command.createAddonRecipe%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.createGenericRecipe",
        "title": "%command.createGenericRecipe%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.createRecipeSchema",
        "title": "%command.createRecipeSchema%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.deleteRecipe",
        "title": "%command.deleteRecipe%",
        "category": "KubeVS",
        "icon": "$(trash)"
      },
      {
        "command": "kubevs.replaceRecipe",
        "title": "%command.replaceRecipe%",
        "category": "KubeVS",
        "icon": "$(replace-all)"
      },
      {
        "command": "kubevs.restoreRecipe",
        "title": "%command.restoreRecipe%",
        "category": "KubeVS",
        "icon": "$(discard)"
      },
      {
        "command": "kubevs.createLootRule",
        "title": "%command.createLootRule%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.createItem",
        "title": "%command.createItem%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.createBlock",
        "title": "%command.createBlock%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.openRegistryBrowser",
        "title": "%command.openRegistryBrowser%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.searchRegistry",
        "title": "%command.searchRegistry%",
        "category": "KubeVS",
        "icon": "$(search)"
      },
      {
        "command": "kubevs.openCraftGraph",
        "title": "%command.openCraftGraph%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.calculateResources",
        "title": "%command.calculateResources%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.importProject",
        "title": "%command.importProject%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.inspectHeldItem",
        "title": "%command.inspectHeldItem%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.showConnectionDiagnostics",
        "title": "%command.showConnectionDiagnostics%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.insertRegistryArray",
        "title": "%command.insertRegistryArray%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.insertTaggedValues",
        "title": "%command.insertTaggedValues%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.insertRecipeJson",
        "title": "%command.insertRecipeJson%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.insertRecipeAsKubeJs",
        "title": "%command.insertRecipeAsKubeJs%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.generateTypings",
        "title": "%command.generateTypings%",
        "category": "KubeVS"
      },
      {
        "command": "kubevs.checkConnection",
        "title": "Check Connection",
        "category": "KubeVS",
        "icon": "$(pulse)"
      },
      {
        "command": "kubevs.openSettings",
        "title": "Settings",
        "category": "KubeVS",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kubevs.openKubeJsSetup",
        "title": "Get KubeJS",
        "category": "KubeVS",
        "icon": "$(link-external)"
      },
      {
        "command": "kubevs.mcp.manage",
        "title": "MCP Server",
        "category": "KubeVS",
        "icon": "$(server)"
      },
      {
        "command": "kubevs.mcp.start",
        "title": "Start MCP Server",
        "category": "KubeVS",
        "icon": "$(play)"
      },
      {
        "command": "kubevs.mcp.stop",
        "title": "Stop MCP Server",
        "category": "KubeVS",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kubevs.mcp.copyConfig",
        "title": "Copy MCP Configuration",
        "category": "KubeVS",
        "icon": "$(copy)"
      },
      {
        "command": "kubevs.mcp.rotateToken",
        "title": "Replace MCP Access Key",
        "category": "KubeVS",
        "icon": "$(key)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kubevs",
          "title": "KubeVS",
          "icon": "media/kubevs.svg"
        }
      ]
    },
    "views": {
      "kubevs": [
        {
          "id": "kubevs.home",
          "name": "Home",
          "type": "webview",
          "icon": "$(dashboard)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kubevs.openDashboard",
          "when": "view == kubevs.home",
          "group": "navigation@1"
        },
        {
          "command": "kubevs.openSettings",
          "when": "view == kubevs.home",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "KubeVS",
      "properties": {
        "kubevs.connector.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "%config.connector.autoConnect.description%"
        },
        "kubevs.connector.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "%config.connector.host.description%"
        },
        "kubevs.connector.port": {
          "type": "number",
          "default": 32145,
          "minimum": 1,
          "maximum": 65535,
          "description": "%config.connector.port.description%"
        },
        "kubevs.connector.secure": {
          "type": "boolean",
          "default": false,
          "description": "%config.connector.secure.description%"
        },
        "kubevs.connector.profile": {
          "type": "string",
          "default": "default",
          "deprecationMessage": "%config.connector.profile.deprecation%",
          "description": "%config.connector.profile.description%"
        },
        "kubevs.connector.autoOpenWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%config.connector.autoOpenWorkspace.description%"
        },
        "kubevs.connector.prepareWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%config.connector.prepareWorkspace.description%"
        },
        "kubevs.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.validation.enabled.description%"
        },
        "kubevs.validation.debounce": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 5000,
          "description": "%config.validation.debounce.description%"
        },
        "kubevs.generatedFiles.directory": {
          "type": "string",
          "default": "kubejs/server_scripts/kubevs",
          "description": "%config.generatedFiles.directory.description%"
        },
        "kubevs.generatedFiles.confirmOverwrite": {
          "type": "boolean",
          "default": true,
          "description": "%config.generatedFiles.confirmOverwrite.description%"
        },
        "kubevs.recipeSchemas.directory": {
          "type": "string",
          "default": ".kubevs/recipe-schemas",
          "description": "%config.recipeSchemas.directory.description%"
        },
        "kubevs.graph.maxDepth": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "maximum": 256,
          "description": "%config.graph.maxDepth.description%"
        },
        "kubevs.graph.maxNodes": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000,
          "description": "%config.graph.maxNodes.description%"
        },
        "kubevs.registry.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.registry.cacheEnabled.description%"
        },
        "kubevs.registry.iconCacheSize": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 5000,
          "description": "%config.registry.iconCacheSize.description%"
        },
        "kubevs.ui.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "%config.ui.compactMode.description%"
        },
        "kubevs.ui.showMinecraftIcons": {
          "type": "boolean",
          "default": true,
          "description": "%config.ui.showMinecraftIcons.description%"
        },
        "kubevs.logs.maxEntries": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000,
          "description": "%config.logs.maxEntries.description%"
        },
        "kubevs.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Start the authenticated local MCP server when a trusted VS Code window loads. Grants configured AI clients access to KubeJS project files and the current Connector session."
        },
        "kubevs.mcp.port": {
          "type": "integer",
          "default": 32146,
          "minimum": 0,
          "maximum": 65535,
          "scope": "application",
          "description": "Local MCP HTTP port. Use 0 to select a free port. The server binds only to 127.0.0.1."
        }
      }
    },
    "grammars": [
      {
        "scopeName": "kubevs.injection",
        "path": "./syntaxes/kubejs.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.ts"
        ]
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/kubejs.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/kubejs.code-snippets"
      }
    ]
  },
  "icon": "media/kubevs-logo.png"
}
